# ========================================================
# 🛒 MART SYSTEM — ENVIRONMENT TEMPLATE (.env.example)
# ========================================================

# 1. Backend API URL (Vite Environment Variable)
# For local Spring Boot backend: http://localhost:8080
# For production Railway backend: https://YOUR-RAILWAY-BACKEND-DOMAIN
VITE_API_URL=http://localhost:8080

# 2. Google OAuth 2.0 Client ID (Public client-side credential)
VITE_GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com

# 3. Application Display Name & Branding (Optional)
VITE_APP_NAME=Mart System

# 4. Canonical Site URL (Optional for SEO)
VITE_SITE_URL=https://martsystemkh.software

# 5. KHQR Payment Polling Frequency in ms (Optional)
VITE_PAYMENT_POLL_INTERVAL_MS=3000
